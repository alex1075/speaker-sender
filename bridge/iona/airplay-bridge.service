[Unit]
Description=Bluetooth (via the Pi) to AirPlay bridge
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=%h/airplay-sender/run-bridge.sh
Restart=always
RestartSec=5
# SIGTERM cancels the main task, which kills the capture ssh (see the runner in bt_airplay_bridge.py)
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=default.target
