[Unit]
Description=Bluetooth to AirPlay bridge
After=bluealsa.service network-online.target
Wants=network-online.target
Requires=bluealsa.service

[Service]
EnvironmentFile=/etc/default/bt-airplay-bridge
ExecStart=/root/airplay-venv/bin/python -u /root/airplay-sender/bt_airplay_bridge.py --target "${TARGET}" --volume ${VOLUME}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
